# Dedicated static, offline-only copy of the existing /demo. No Python,
# DATABASE_URL, Supabase, OpenAI or SocialCrawl runtime is installed.
FROM node:22-alpine AS build
WORKDIR /src/frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY frontend/ ./
ENV VITE_DEMO_STANDALONE=1
RUN npm run build

FROM nginx:1.27-alpine
COPY deploy/polri-demo.nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /src/frontend/dist /usr/share/nginx/html
EXPOSE 10000
CMD ["nginx","-g","daemon off;"]
