      "user_condition": {
        "role": "access_grant_writer"
      }
    },
    "update": {
      "user_condition": {
        "role": "access_grant_writer"
      }
    },
    "delete": {
      "user_condition": {
        "role": "access_grant_writer"
      }
    }
  }
}